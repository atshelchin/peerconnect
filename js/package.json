{
  "name": "peerconnect",
  "version": "0.1.0",
  "description": "PeerConnect: end-to-end encrypted rooms and groups (commands, chat, voice) over an untrusted WebSocket relay",
  "keywords": [
    "e2ee",
    "end-to-end encryption",
    "noise",
    "websocket",
    "relay",
    "pairing",
    "webassembly",
    "voice chat",
    "multiplayer"
  ],
  "homepage": "https://peerconnect.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atshelchin/peerconnect.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/atshelchin/peerconnect/issues"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./voice": {
      "types": "./voice.d.ts",
      "default": "./voice.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "voice.js",
    "voice.d.ts",
    "dist/",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "./index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "sh scripts/build.sh",
    "test": "node --test test/*.test.js",
    "prepack": "cp ../LICENSE-MIT ../LICENSE-APACHE . && test -f dist/module.js",
    "test:voice": "node test/voice.browser.mjs"
  }
}
