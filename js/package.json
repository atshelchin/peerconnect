{
  "name": "peerconnect",
  "private": true,
  "version": "0.1.0",
  "description": "PeerConnect reference implementation in JavaScript (the Rust core in WebAssembly). Not published: PeerConnect is offered as an API (API.md, SPEC.md).",
  "keywords": [
    "e2ee",
    "end-to-end encryption",
    "noise",
    "websocket",
    "relay",
    "pairing",
    "webassembly"
  ],
  "homepage": "https://peerconnect.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atshelchin/peerconnect.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/atshelchin/peerconnect/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./auth": {
      "types": "./auth.d.ts",
      "default": "./auth.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "auth.js",
    "auth.d.ts",
    "dist/",
    "LICENSE"
  ],
  "sideEffects": [
    "./index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "sh scripts/build.sh",
    "test": "node --test",
    "prepack": "cp ../LICENSE . && test -f dist/module.js"
  }
}
