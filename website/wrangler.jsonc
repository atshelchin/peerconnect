{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "peerconnect-website",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Served at peerconnect.dev only: a second host would duplicate every page.
	"routes": [{ "pattern": "peerconnect.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true,
	// Developer accounts and relay tokens (docs/self-serve.md). Secrets, set
	// with `wrangler secret put`: SERVICE_SECRET (the relay's
	// PEERCONNECT_SERVICE_SECRET), GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
	// SESSION_KEY, APP_SECRET_KEY. The site never holds the token secret: the
	// relay signs.
	"d1_databases": [
		{
			"binding": "SITE_DB",
			"database_name": "peerconnect-site",
			// Created 2026-10-28.
			"database_id": "633a8ead-0aa6-42a5-ba3b-0d5e37d65383",
			"migrations_dir": "migrations"
		}
	],
	"services": [{ "binding": "RELAY", "service": "peerconnect-relay" }],
	"vars": {
		"RELAY_PUBLIC_URL": "wss://relay.peerconnect.dev",
		"ADMIN_GITHUB_ID": "113176571"
	}
}
