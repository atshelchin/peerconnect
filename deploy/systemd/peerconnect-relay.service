# The relay as a systemd service, with a certificate from certbot (see
# README.md in this directory). Groups need UDP 443 open; rooms use TCP 443.
[Unit]
Description=PeerConnect relay
After=network-online.target
Wants=network-online.target

[Service]
User=peerconnect
Group=peerconnect
ExecStart=/usr/local/bin/peerconnect-relay
Environment=PEERCONNECT_LISTEN=0.0.0.0:443
Environment=PEERCONNECT_TLS_CERT=/etc/peerconnect/tls/fullchain.pem
Environment=PEERCONNECT_TLS_KEY=/etc/peerconnect/tls/privkey.pem
# The server's traffic: its month's allowance (shared with anything else on
# it, so leave room) and a rate to stay under. Video shrinks for everyone as
# they are approached; voice never does. The month's usage survives restarts.
Environment=PEERCONNECT_MONTHLY_GB=1500
Environment=PEERCONNECT_MAX_MBPS=500
Environment=PEERCONNECT_USAGE_FILE=/var/lib/peerconnect/usage
StateDirectory=peerconnect
# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
LimitNOFILE=65536
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
